# Public versions of these two live in arqstudiocad.core.
type _Point = tuple[float, float]

class _PointLike(Protocol):
    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> SupportsFloat: ...

type _PathLike = str | PathLike[str]

class _Ids(Protocol):
    """Entity ids: any sequence of ints (list, tuple, NumPy integer array)."""

    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> SupportsIndex: ...

# Errors (ADR 0012, D4.4)

class CadError(Exception):
    code: ClassVar[str]

class InvalidGeometryError(CadError): ...

class EntityNotFoundError(CadError):
    entity_id: int

class LayerNotFoundError(CadError):
    layer_id: int

class DocumentNotFoundError(CadError):
    document_id: int

class InvalidOperationError(CadError): ...
class CadIoError(CadError): ...
class DamagedFileError(CadIoError): ...
class OverwritesDamagedError(CadIoError): ...
class SaveNotVerifiedError(CadIoError): ...

class LossyConversionError(CadIoError):
    loss_kinds: list[str]
    losses: list[str]

class UnsupportedFormatError(CadError): ...

